{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "buildCommand": "npm run check",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?p=home"
    },
    {
      "source": "/menu",
      "destination": "/api/page?p=menu"
    },
    {
      "source": "/menu-file",
      "destination": "/api/menu-file"
    },
    {
      "source": "/menu-qr.svg",
      "destination": "/api/qr"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
